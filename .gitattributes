# Preserve official downloaded snapshots byte-for-byte and avoid line-ending rewrites.
data/raw/*.html binary
data/raw/*.xml binary
data/raw/*.zip binary

# Official third-party source snapshots should not affect GitHub language statistics.
data/raw/** linguist-vendored

# Office and analytical binary artifacts.
*.docx binary
*.xlsx binary
*.parquet binary
*.duckdb binary
*.png binary
